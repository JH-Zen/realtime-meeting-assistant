# 复制成仓库根的 `.env` 再填值。后端唯一读环境变量的地方是
# packages/backend/src/config/env.ts，注释里的默认值就是这里列的值。
#
# 顺序：进程已有的环境变量优先，`.env` 不会覆盖它。所以临时改用 Mock 只要
# `MOCK_LLM=true npm run dev:backend`，不必改文件。
# 空字符串一律当作"未设置"并回落到默认值（`LLM_MODEL=` 不等于空模型名）。

# ── HTTP / WS ────────────────────────────────────────────────────────────
# 只接受回环：127.0.0.1 / localhost / ::1。桌面强制独立动态端口，忽略此处位置配置。
HOST=127.0.0.1
PORT=8787
DB_PATH=var/rcc.sqlite
# 后端自己伺服前端页面的目录（相对进程工作目录，与 DB_PATH 同一口径）。
# 目录里没有 index.html 就完全不挂载路由，源码 + `vite dev` 的正常开发不受影响。
STATIC_DIR=packages/frontend/dist

# ── Mock 模式（设计文档要求无 key 也能跑通全链路）────────────────
MOCK_STT=true
MOCK_LLM=true
MOCK_EMBEDDING=true
# 仅 MOCK_STT=true 有意义：语速倍数与重复趟数（逐趟续排 segment id）。
MOCK_STT_SPEED=1
MOCK_STT_REPEAT=1

# ── 真实 STT（services/stt-worker 的 Python 进程）─────────────────
# worker 地址仅支持本机回环；当前采集输出固定为 16000 Hz，不支持另填采样率。
STT_WS_URL=ws://127.0.0.1:6006
STT_SAMPLE_RATE=16000

# ── 真实 LLM（OpenAI 兼容端点）──────────────────────────────────────
# MOCK_LLM=false 时必须提供 LLM_API_KEY；缺失会明确启动失败，不自动回退模拟。
# 实测（2026-10-21，docs/ARCHITECTURE_DECISION.md §6.5 D-31）：
#   · 这类端点上 `json_schema` strict 不可用，代码只发 `json_object`；
#   · `LLM_DISABLE_THINKING=false` 时同一批调用要 27–106 s，会顶穿 timeoutMs；
#   · `glm-5.3` 拒绝 enable_thinking=false，`kimi-k3` 拒绝 temperature——换模型前先读 D-31。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_DISABLE_THINKING=true

# ── MindMap 触发与上下文窗口 ───────────────────────────────────────
MINDMAP_MIN_SEGMENTS=6
MINDMAP_MAX_INTERVAL_MS=25000
MINDMAP_WINDOW_SEC=45

# ── Memory / 摘要 ──────────────────────────────────────────────────
SUMMARY_WINDOW_SEC=240
SUMMARY_MERGE_FACTOR=4
SUMMARY_MIN_SEGMENTS=1
SUMMARY_MAX_LEVEL=2
HOT_CONTEXT_SEC=240

# ── 检索 / embedding（bge-m3 是 1024 维，换模型必须同时改 EMBED_DIM）──
EMBED_MODEL=Xenova/bge-m3
EMBED_DTYPE=q8
EMBED_DIM=1024
EMBED_MODEL_DIR=models/embedding
EMBED_REMOTE_HOST=https://hf-mirror.com/
EMBED_TIMEOUT_MS=15000
EMBED_LOAD_TIMEOUT_MS=300000
RETRIEVAL_TOP_K=10
# 注意：0.1 只是 Mock 的下界。bge-m3 实测答案行 0.87–0.96、同题干扰 0.71–0.77、
# 完全离题也有 0.66，所以真跑检索要把这个数抬到 0.75 左右。
RETRIEVAL_MIN_SCORE=0.1
EMBED_BATCH_SIZE=16
RETRIEVAL_MAX_PENDING=512

# ── 限流与观测 ────────────────────────────────────────────────────
QA_MIN_INTERVAL_MS=1500
LOOP_DELAY_REPORT_MS=10000

# Vite 开发默认连接同主机 8787；正式/桌面页面使用实际同源地址。
# Vite 使用 localhost 或 127.0.0.1 的 5173 端口，API 与页面应使用相同主机名：
# VITE_API_BASE=http://127.0.0.1:8787
# VITE_WS_URL=ws://127.0.0.1:8787/ws
