{
  "name": "realtime-cognitive-companion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time Cognitive Companion - streaming STT + incremental mind map + parallel Q&A",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "build": "npm run build -w @rcc/shared && npm run build -w @rcc/backend && npm run build -w @rcc/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:backend": "npm run dev -w @rcc/backend",
    "dev:frontend": "npm run dev -w @rcc/frontend"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
